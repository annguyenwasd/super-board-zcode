{
  "_comment": "Intermediate representation, not ZCode config: scripts/super-board-settings.py zcode-hooks re-nests these hooks.<Event> entries into the workspace config's hooks.events.<Event> and sets hooks.enabled. Keep hooks/README.md's copy of this block identical.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${ZCODE_PROJECT_DIR}\"/.zcode/hooks/guard-worktree-path.py"
          },
          {
            "type": "command",
            "command": "python3 \"${ZCODE_PROJECT_DIR}\"/.zcode/hooks/guard-delete-outside.py"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${ZCODE_PROJECT_DIR}\"/.zcode/hooks/guard-secrets.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${ZCODE_PROJECT_DIR}\"/.zcode/hooks/guard-key-literals.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${ZCODE_PROJECT_DIR}\"/.zcode/hooks/guard-key-literals.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${ZCODE_PROJECT_DIR}\" && python3 .zcode/hooks/cleanup-wt.py --auto --fetch 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
